#!/usr/bin/with-contenv bash
# Runs after the base's init-selkies-config and before init-config-end, so it
# lands after the base's first-run copy and before init-services starts the
# desktop.

mkdir -p /config/drives /config/logs /config/.config/openbox

# Copied on EVERY boot. The base copies menu.xml/autostart only when absent, so
# image updates would otherwise never reach existing installs.
cp /defaults/menu.xml /config/.config/openbox/menu.xml
cp /defaults/autostart /config/.config/openbox/autostart

# Never recursive: prefixes under /config/drives are large.
chown abc:abc \
  /config/drives \
  /config/logs \
  /config/.config/openbox \
  /config/.config/openbox/menu.xml \
  /config/.config/openbox/autostart

# Selkies' own nginx server (3000, and 3001 with a self-signed cert) listens on
# every interface by default, so any container on the Umbrel's Docker network
# could drive the desktop without logging in. Only our :8080 server (conf.d,
# which proxies to 127.0.0.1:3000) needs to be reachable. The base regenerates
# this file on every boot (init-nginx, which init-selkies-config waits for),
# so this runs every boot too; it is idempotent.
sed -i -E \
  -e '/^[[:space:]]*listen \[::\]:/d' \
  -e 's/^([[:space:]]*)listen ([0-9]+)([ ;])/\1listen 127.0.0.1:\2\3/' \
  /etc/nginx/sites-available/default

# GPU: the manifest requests Umbrel's GPU permission, so umbrelOS mounts
# /dev/dri when the host has one. On x86 (Umbrel Home: Intel) the base then
# renders on the GPU (Xvfb with glamor/DRI3, so Wine gets hardware OpenGL) and
# encodes the stream there with VA-API, zero copy. A Raspberry Pi's GPU has no
# video encoder and GPU rendering under box64 is unproven, so arm64 stays on
# the CPU path: the base would otherwise start Xvfb on the Pi's render node
# (svc-xorg picks the first renderD* on any arch) and aim the encoder at it
# (init-selkies-config sets DRI_NODE). Services read this environment when
# they start, which is after this oneshot.
if [ "$(uname -m)" = "aarch64" ]; then
  printf "true" > /run/s6/container_environment/DISABLE_DRI3
  printf "false" > /run/s6/container_environment/AUTO_GPU
  printf -- "-1" > /run/s6/container_environment/SELKIES_GPU_ID
  rm -f /run/s6/container_environment/DRI_NODE /run/s6/container_environment/DRINODE
fi
